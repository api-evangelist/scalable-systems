  "info": {
    "_postman_id": "d7f1b251-9c58-431a-865c-eb0448c01305",
    "name": "AWS Application Auto Scaling ApplicationAutoScaling API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The AWS Application Auto Scaling API lets you register and manage scalable\ntargets (DynamoDB, ECS, Aurora, ElastiCache, Lambda provisioned concurrency,\nSageMaker endpoints, AppStream fleets, EMR, Keyspaces, Neptune, MSK, Spot\nFleet, WorkSpaces, and custom resources), configure scaling policies and\nscheduled actions, and inspect scaling activity. It is an AWS query API\ntransported over HTTPS POST to a regional endpoint, with requests signed\nusing AWS Signature v4. This file is an API Evangelist research artifact\nfor the scalable-systems topic.\n\n\nContact Support:\n Name: API Evangelist",
      "type": "text/plain"
    }
  }
